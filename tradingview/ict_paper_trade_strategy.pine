// © ICT Paper Trade -- Pine v6 port of judas_swing + sbs models
// paper_trade.py + ict_models.py kurallarinin birebir Pine v6 karsiligi.
//@version=6
strategy(
     "ICT Paper Trade Strategy",
     overlay              = true,
     initial_capital      = 5000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 100,
     pyramiding           = 0,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.05,
     slippage             = 2,
     process_orders_on_close = true,
     max_bars_back        = 500)

// ==================================================================
// INPUTS
// ==================================================================
useJudas    = input.bool(true,  "Enable Judas Swing", group="Models")
useSbs      = input.bool(true,  "Enable SBS",         group="Models")

rrRatio     = input.float(2.0,  "Risk:Reward (TP)",   minval=0.5, step=0.1, group="Risk")
riskPct     = input.float(2.0,  "Risk % per trade",   minval=0.1, step=0.1, group="Risk")
cooldownBar = input.int(5,      "Cooldown (bars)",    minval=0, group="Risk")

rsiLen      = input.int(14,     "RSI length",         minval=2,  group="SBS")
rsiLow      = input.int(30,     "RSI lower band",     group="SBS")
rsiHigh     = input.int(70,     "RSI upper band",     group="SBS")
boLookback  = input.int(15,     "Breakout lookback",  minval=5,  group="SBS")
retestBars  = input.int(5,      "Retest window",      minval=1,  group="SBS")
atrLen      = input.int(20,     "ATR length (SBS SL)",minval=5,  group="SBS")
atrMult     = input.float(0.5,  "Retest tolerance * ATR", step=0.1, group="SBS")

useKillzone = input.bool(true,  "Restrict SBS to killzones", group="SBS")
londonStart = input.int(2,      "London start (EST hour)", minval=0, maxval=23, group="SBS")
londonEnd   = input.int(5,      "London end (EST hour)",   minval=0, maxval=23, group="SBS")
nyStart     = input.int(7,      "NY start (EST hour)",     minval=0, maxval=23, group="SBS")
nyEnd       = input.int(10,     "NY end (EST hour)",       minval=0, maxval=23, group="SBS")

// ==================================================================
// SWING PIVOTS (paper_trade JUDASSWING.swing_highs_lows)
// ==================================================================
swingHigh1 = high[1] > high[2] and high[1] > high[0]
swingLow1  = low[1]  < low[2]  and low[1]  < low[0]

var int   p1Type = 0
var int   p2Type = 0
var int   p3Type = 0
var float p1Lvl  = na
var float p2Lvl  = na
var float p3Lvl  = na

if swingHigh1
    p1Type := p2Type
    p2Type := p3Type
    p3Type := 1
    p1Lvl  := p2Lvl
    p2Lvl  := p3Lvl
    p3Lvl  := high[1]
else if swingLow1
    p1Type := p2Type
    p2Type := p3Type
    p3Type := -1
    p1Lvl  := p2Lvl
    p2Lvl  := p3Lvl
    p3Lvl  := low[1]

// ==================================================================
// COMMON HELPERS
// ==================================================================
atrProxy = ta.sma(high - low, atrLen)
rsiVal   = ta.rsi(close, rsiLen)
momentumOk = rsiVal > rsiLow and rsiVal < rsiHigh

inKillzone() =>
    h = hour(time, "America/New_York")
    (h >= londonStart and h < londonEnd) or (h >= nyStart and h < nyEnd)

// ==================================================================
// JUDAS SWING
// L-H-L + HL (3.low > 1.low)  ->  LONG; entry=3.low, stop=1.low
// H-L-H + LH (3.high < 1.high)->  SHORT;entry=3.high, stop=1.high
// ==================================================================
judasLong  = useJudas and p1Type == -1 and p2Type ==  1 and p3Type == -1 and p3Lvl > p1Lvl
judasShort = useJudas and p1Type ==  1 and p2Type == -1 and p3Type ==  1 and p3Lvl < p1Lvl

float judasEntry = judasLong or judasShort ? p3Lvl : na
float judasStop  = judasLong or judasShort ? p1Lvl : na

// ==================================================================
// SBS  (momentum + killzone + breakout + retest)
// ==================================================================
float breakHigh = ta.highest(high[1], boLookback)
float breakLow  = ta.lowest (low[1],  boLookback)
bool  breakBull = close > breakHigh
bool  breakBear = close < breakLow

float tol = atrProxy * atrMult

// Son retestBars icinde level + tol bolgesine dokunma var mi
bool  retestLong  = false
bool  retestShort = false
float retestPxL   = na
float retestPxS   = na

if breakBull
    for i = 0 to retestBars - 1
        if low[i] <= breakHigh + tol
            retestLong := true
            retestPxL  := low[i]
            break

if breakBear
    for i = 0 to retestBars - 1
        if high[i] >= breakLow - tol
            retestShort := true
            retestPxS   := high[i]
            break

bool sessionOk = not useKillzone or inKillzone()
bool sbsLong   = useSbs and breakBull and retestLong  and momentumOk and sessionOk
bool sbsShort  = useSbs and breakBear and retestShort and momentumOk and sessionOk

float sbsEntry = sbsLong ? retestPxL : sbsShort ? retestPxS : na
float sbsStop  = sbsLong ? retestPxL - atrProxy : sbsShort ? retestPxS + atrProxy : na

// ==================================================================
// DISPATCH (judas oncelikli)
// ==================================================================
bool isLong  = judasLong  or sbsLong
bool isShort = judasShort or sbsShort
string modelLbl = judasLong or judasShort ? "judas" : sbsLong or sbsShort ? "sbs" : ""

float entryPx = judasLong  or judasShort ? judasEntry : sbsLong or sbsShort ? sbsEntry : na
float stopPx  = judasLong  or judasShort ? judasStop  : sbsLong or sbsShort ? sbsStop  : na

float risk   = math.abs(entryPx - stopPx)
float tpPx   = isLong ? entryPx + risk * rrRatio : isShort ? entryPx - risk * rrRatio : na

bool validLong  = isLong  and not na(stopPx) and not na(tpPx) and stopPx < entryPx and tpPx > entryPx
bool validShort = isShort and not na(stopPx) and not na(tpPx) and stopPx > entryPx and tpPx < entryPx

// ==================================================================
// COOLDOWN + ORDERS
// ==================================================================
var int lastEntryBar = na
bool canEnter = na(lastEntryBar) or (bar_index - lastEntryBar) > cooldownBar
bool inFlat   = strategy.position_size == 0

qty(float eq, float e, float s) =>
    rAmt = eq * riskPct / 100.0
    dist = math.abs(e - s)
    dist > 0 ? rAmt / dist : 0.0

if validLong and inFlat and canEnter
    q = qty(strategy.equity, entryPx, stopPx)
    strategy.entry("L-" + modelLbl, strategy.long, qty=q, comment=modelLbl + " LONG")
    strategy.exit("X-L", from_entry="L-" + modelLbl, stop=stopPx, limit=tpPx)
    lastEntryBar := bar_index

if validShort and inFlat and canEnter
    q = qty(strategy.equity, entryPx, stopPx)
    strategy.entry("S-" + modelLbl, strategy.short, qty=q, comment=modelLbl + " SHORT")
    strategy.exit("X-S", from_entry="S-" + modelLbl, stop=stopPx, limit=tpPx)
    lastEntryBar := bar_index

// ==================================================================
// VISUALS + ALERTS
// ==================================================================
plotshape(judasLong,  title="Judas LONG",  style=shape.triangleup,   location=location.belowbar, color=color.new(#5fa8d3, 0), size=size.small)
plotshape(judasShort, title="Judas SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(#5fa8d3, 0), size=size.small)
plotshape(sbsLong,    title="SBS LONG",    style=shape.triangleup,   location=location.belowbar, color=color.new(#f4a261, 0), size=size.small)
plotshape(sbsShort,   title="SBS SHORT",   style=shape.triangledown, location=location.abovebar, color=color.new(#f4a261, 0), size=size.small)

bgcolor(useKillzone and inKillzone() ? color.new(color.yellow, 92) : na, title="Killzone")

alertcondition(validLong,  title="LONG signal",  message="ICT LONG entry={{close}}")
alertcondition(validShort, title="SHORT signal", message="ICT SHORT entry={{close}}")
